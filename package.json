{
  "name": "gitreqd",
  "private": true,
  "description": "Requirement management tool",
  "type": "module",
  "scripts": {
    "build": "bash ./scripts/build-wasm-core.sh && npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "validate": "cargo run -p gitreqd -- validate",
    "format": "cargo run -p gitreqd -- format",
    "html": "cargo run -p gitreqd -- html",
    "bootstrap": "cargo run -p gitreqd -- bootstrap",
    "test": "jest"
  },
  "workspaces": [
    "packages/core",
    "packages/vscode"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6"
  },
  "overrides": {
    "dompurify": "3.3.3",
    "brace-expansion": "5.0.5"
  }
}
