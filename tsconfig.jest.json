{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shallgraph/core": ["packages/core/src/index.ts"],
      "@shallgraph/core/html": ["packages/core/src/html.ts"],
      "@shallgraph/core/engine": ["packages/core/src/engine.ts"],
      "@shallgraph/core/types": ["packages/core/src/types.ts"],
      "@shallgraph/core/*": ["packages/core/src/*"]
    }
  },
  "include": ["packages/**/*"]
}

