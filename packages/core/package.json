{
  "name": "@gitreqd/core",
  "version": "0.4.0",
  "description": "JS facade over gitreqd-core WASM — parse, validate, format, and HTML",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": {
    "./dist/wasm.js": "./dist/wasm.browser.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "browser": "./dist/html.js",
      "node": "./dist/html.js",
      "import": "./dist/html.js",
      "default": "./dist/html.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "browser": "./dist/engine.js",
      "node": "./dist/engine.js",
      "import": "./dist/engine.js",
      "default": "./dist/engine.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "browser": "./dist/wasm.browser.js",
      "node": "./dist/wasm.js",
      "default": "./dist/wasm.js"
    }
  },
  "scripts": {
    "build": "bash ../../scripts/build-wasm-core.sh && rm -rf dist && tsc && mkdir -p dist/wasm dist/wasm-web && cp wasm/gitreqd_wasm.js wasm/gitreqd_wasm_bg.wasm wasm/package.json dist/wasm/ && cp wasm-web/gitreqd_wasm.js wasm-web/gitreqd_wasm_bg.wasm dist/wasm-web/",
    "clean": "rm -rf dist wasm wasm-web"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "requirements",
    "yaml"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
